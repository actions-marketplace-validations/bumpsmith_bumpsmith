# Bumpsmith environment variables
#
# Copy to .env and fill in what you use. Bumpsmith reads these from the process environment
# (it does not load .env itself): export them in your shell, put them in a systemd unit
# (deploy/bumpsmith.service), in deploy/.env for Docker Compose, or in your CI secrets.
# Nothing here is required to try it locally: `npx bumpsmith dashboard` and the setup wizard
# can store model keys and the GitHub connection encrypted in the dashboard instead.

# ─── Model provider: set ONE (or sign in to Claude Code / Codex on your own machine) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=

# ─── GitHub ───
# Needed by `bumpsmith rescue --github owner/repo` and for higher GitHub API rate limits.
# A fine-grained token with Contents and Pull requests (read and write) on the repository.
# In GitHub Actions this is set for you.
GITHUB_TOKEN=

# ─── Self-hosted server (`bumpsmith server`) ───
# Required: the address people open. Must be https://, except http://localhost.
BUMPSMITH_PUBLIC_URL=https://bumpsmith.example.com
# Database, key file and cloned repositories. Default ~/.bumpsmith
BUMPSMITH_DATA=/var/lib/bumpsmith
# Bind address and port (defaults: 127.0.0.1 behind a proxy; port 4477, or 4443 with TLS).
BUMPSMITH_HOST=127.0.0.1
BUMPSMITH_PORT=4477
# Either terminate TLS in a reverse proxy...
BUMPSMITH_BEHIND_PROXY=1
BUMPSMITH_TRUSTED_PROXIES=127.0.0.1,::1
# ...or serve HTTPS directly (leave BUMPSMITH_BEHIND_PROXY unset then).
BUMPSMITH_TLS_CERT=
BUMPSMITH_TLS_KEY=
# Master key (32 bytes, base64) that encrypts secrets at rest. Prefer the file (a Docker or
# Kubernetes secret, or a file decrypted from your KMS at boot). Generate one with:
#   openssl rand -base64 32
# If neither is set, a key file is created in the data folder on first run.
BUMPSMITH_MASTER_KEY_FILE=/run/secrets/master_key
BUMPSMITH_MASTER_KEY=

# ─── Docker Compose (deploy/compose.yaml reads deploy/.env) ───
BUMPSMITH_DOMAIN=bumpsmith.example.com

# ─── Optional ───
# Where the sandbox keeps its working data. Default .data/ in the package.
BUMPSMITH_DATA_DIR=
# Use a specific Claude Code or Codex binary, or a specific Codex model.
BUMPSMITH_CLAUDE_BIN=
BUMPSMITH_CODEX_BIN=
BUMPSMITH_CODEX_MODEL=
# Port for `pnpm demo:workspace` (default 4479).
DEMO_PORT=4479
