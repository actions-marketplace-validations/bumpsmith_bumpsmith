# systemd unit for running `bumpsmith server` directly on a VM with Docker (recommended when
# Bumpsmith should run upgrades itself). See docs/self-hosting.md.
#
#   sudo useradd --system --home /var/lib/bumpsmith --shell /usr/sbin/nologin bumpsmith
#   sudo usermod -aG docker bumpsmith          # sandboxes; docker group is root-equivalent
#   sudo install -d -o bumpsmith -m 700 /var/lib/bumpsmith /var/lib/bumpsmith/tmp /etc/bumpsmith
#   sudo cp bumpsmith.service /etc/systemd/system/ && sudo systemctl enable --now bumpsmith

[Unit]
Description=Bumpsmith server
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=bumpsmith
Group=bumpsmith
Environment=NODE_ENV=production
Environment=BUMPSMITH_DATA=/var/lib/bumpsmith
# Sandboxes bind-mount from here; the Docker engine cannot see a private /tmp.
Environment=TMPDIR=/var/lib/bumpsmith/tmp
Environment=BUMPSMITH_PUBLIC_URL=https://bumpsmith.example.com
Environment=BUMPSMITH_BEHIND_PROXY=1
Environment=BUMPSMITH_TRUSTED_PROXIES=127.0.0.1,::1
# 32 random bytes, base64 (openssl rand -base64 32), readable only by root; systemd passes it in.
LoadCredential=master_key:/etc/bumpsmith/master.key
Environment=BUMPSMITH_MASTER_KEY_FILE=%d/master_key
ExecStart=/usr/bin/env npx --yes bumpsmith@0.1.0 server
Restart=on-failure
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/bumpsmith
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
